SPRING_PROFILES_ACTIVE=prod,swagger

# Database
SPRING_DATASOURCE_URL="jdbc:postgresql://postgresql:5432/managementportal"
SPRING_DATASOURCE_USERNAME="managementportal"
SPRING_DATASOURCE_PASSWORD="mp_dev_password"

SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT="15000"
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT="10000"

# Management Portal settings
MANAGEMENTPORTAL_COMMON_ADMIN_PASSWORD="admin"
MANAGEMENTPORTAL_FRONTEND_CLIENT_SECRET="jUEYpFE8XDXxy48XCBK9oD5I2tsgzy5Anku2lkn"
MANAGEMENTPORTAL_COMMON_PRIVACY_POLICY_URL="http://info.thehyve.nl/radar-cns-privacy-policy"
MANAGEMENTPORTAL_COMMON_BASEURL="http://localhost"
MANAGEMENTPORTAL_COMMON_MANAGEMENT_PORTAL_BASE_URL="http://localhost/managementportal"
MANAGEMENTPORTAL_OAUTH_CLIENTS_FILE="/secrets/oauth_client_details.csv"
MANAGEMENTPORTAL_CATALOGUE_SERVER_ENABLE_AUTO_IMPORT="false"
# MANAGEMENTPORTAL_CATALOGUE_SERVER_SERVER_URL="http://catalog-server:9010/source-types"
MANAGEMENTPORTAL_OAUTH_REQUIRE_AAL2="false"

# JWT key aliases (matches the aliases in keystore.p12)
SPRING_APPLICATION_JSON='{"managementportal":{"oauth":{"checkingKeyAliases":["radarbase-managementportal-ec","selfsigned"]},"common":{"useConsole":true,"consoleBaseUrl":"http://localhost/radarbase-console/"}}}'

# SMTP – routed to local Mailhog
# MANAGEMENTPORTAL_MAIL_FROM="noreply@example.com"
SPRING_MAIL_HOST="mailhog"
SPRING_MAIL_PORT="1025"
# SPRING_MAIL_USERNAME=${SMTP_USERNAME}
# SPRING_MAIL_PASSWORD=${SMTP_PASSWORD}
SPRING_MAIL_FROM="noreply@localhost"
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH="false"
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE="false"

JHIPSTER_SLEEP="0"
JAVA_OPTS="-Xmx512m"
